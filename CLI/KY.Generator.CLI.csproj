<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RollForward>Major</RollForward>
        <RootNamespace>KY.Generator</RootNamespace>
        <AssemblyName>KY.Generator</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>KY.Generator.CLI</PackageId>
        <Version>10.1.2</Version>
        <Title>KY.Generator.CLI</Title>
        <Authors>KY-Programming</Authors>
        <Company>KY-Programming</Company>
        <Copyright>2026 - KY-Programming</Copyright>
        <Description>Command line interface for KY.Generator, installable as a .NET global tool:
            dotnet tool install -g KY.Generator.CLI
            Generate C# or TypeScript classes from .NET assemblies, JSON, TSQL or oData.
            Support for Angular, ASP.NET, ASP.NET Core, C# POCOs, TypeScript POCOs, Entity Framework and more.
        </Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/KY-Programming/generator</PackageProjectUrl>
        <PackageIcon>assets\icon.png</PackageIcon>
        <PackageReadmeFile>docs\README.md</PackageReadmeFile>
        <PackageTags>KY-Generator KY.Generator CLI dotnet-tool</PackageTags>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>ky-generator</ToolCommandName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>bin\Release\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KY.Core.Common" Version="10.1.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Angular.Generator\KY.Generator.Angular.Generator.csproj" />
        <ProjectReference Include="..\Angular\KY.Generator.Angular.csproj" />
        <ProjectReference Include="..\AspDotNet.Generator\KY.Generator.AspDotNet.Generator.csproj" />
        <ProjectReference Include="..\AspDotNet\KY.Generator.AspDotNet.csproj" />
        <ProjectReference Include="..\Common.Generator\KY.Generator.Common.Generator.csproj" />
        <ProjectReference Include="..\Common\KY.Generator.Common.csproj" />
        <ProjectReference Include="..\Csharp.Generator\KY.Generator.CSharp.Generator.csproj" />
        <ProjectReference Include="..\CSharp\KY.Generator.Csharp.csproj" />
        <ProjectReference Include="..\Json.Generator\KY.Generator.Json.Generator.csproj" />
        <ProjectReference Include="..\Reflection.Generator\KY.Generator.Reflection.Generator.csproj" />
        <ProjectReference Include="..\Reflection\KY.Generator.Reflection.csproj" />
        <ProjectReference Include="..\Sqlite.Generator\KY.Generator.Sqlite.Generator.csproj" />
        <ProjectReference Include="..\Sqlite\KY.Generator.Sqlite.csproj" />
        <ProjectReference Include="..\Tsql.Generator\KY.Generator.Tsql.Generator.csproj" />
        <ProjectReference Include="..\Tsql\KY.Generator.Tsql.csproj" />
        <ProjectReference Include="..\TypeScript.Generator\KY.Generator.TypeScript.Generator.csproj" />
        <ProjectReference Include="..\TypeScript\KY.Generator.TypeScript.csproj" />
        <ProjectReference Include="..\Watchdog\KY.Generator.Watchdog.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\icon.png" Pack="true" PackagePath="assets" Visible="false" />
        <None Include="..\README.md" Pack="true" PackagePath="docs" Visible="false" />
    </ItemGroup>

</Project>
