<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 so the module can be loaded by every generator build, from .NET Framework
             4.6.2 up to the current .NET. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Only the base package. This half holds the command parameters and the fluent API - everything
             a user of the module references. Nothing that generates lives here. -->
        <PackageReference Include="KY.Generator.Common" Version="10.1.0" />
        <!-- Logger and the Assert helpers. KY.Generator.Common does not declare it as a dependency. -->
        <PackageReference Include="KY.Core.Common" Version="10.1.0" />
    </ItemGroup>

</Project>
