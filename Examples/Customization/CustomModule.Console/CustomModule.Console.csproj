<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- The generator stamps this id into every file it writes and recognises its own output by it,
             so it can clean up files it no longer generates. -->
        <ProjectGuid>{5168D506-DD1D-4851-AB6C-628732ADE155}</ProjectGuid>
    </PropertyGroup>

    <ItemGroup>
        <!-- The tool. Its MSBuild targets run the generation after this project is compiled. -->
        <PackageReference Include="KY.Generator" Version="10.1.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- A user of a published module would reference its single NuGet package and get both halves
             from it. Here the two projects are referenced directly, so the module can be developed and
             tried out without packing it first. -->
        <ProjectReference Include="..\CustomModule\CustomModule.csproj" />
        <!-- The generator half is not compiled against - it only has to sit next to the assembly at run
             time, which is where the generator looks for what [assembly: GenerateWith] names. -->
        <ProjectReference Include="..\CustomModule.Generator\CustomModule.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
